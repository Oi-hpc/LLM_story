# 复制为 .env 并填写你的 API Key

# ---------- 使用 DeepSeek API ----------
OPENAI_API_KEY=你的DeepSeek_API_Key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---------- 使用 OpenAI 官方 ----------
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 可选：请求超时毫秒数，默认 90000
# REQUEST_TIMEOUT_MS=90000

# ---------- Grok 场景生图（OpenAI 兼容接口） ----------
# 填写你的第三方接口 Key 和 OpenAI 兼容 base URL（通常以 /v1 结尾）
GROK_API_KEY=你的第三方_Grok_API_Key
GROK_BASE_URL=https://你的第三方接口地址/v1
# 必须改成第三方实际提供的生图模型 ID
GROK_IMAGE_MODEL=你的_Grok_生图模型_ID
# 可选：第三方要求 Base64 返回时改为 b64_json，默认 url
# GROK_IMAGE_RESPONSE_FORMAT=url
# 可选：仅在第三方文档明确支持时启用
# GROK_IMAGE_SIZE=1792x1024
# GROK_IMAGE_ASPECT_RATIO=16:9
# 可选：提示词生成及生图各自的超时毫秒数，默认 120000
# IMAGE_REQUEST_TIMEOUT_MS=120000
